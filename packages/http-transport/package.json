{
  "name": "@youzi9601/mcp-testkit-http",
  "version": "0.1.7",
  "description": "HTTP transport for MCP test servers",
  "keywords": [
    "mcp",
    "http",
    "transport",
    "http-transport",
    "model-context-protocol"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "test": "vitest run src",
    "test:coverage": "vitest run src --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "peerDependencies": {
    "@youzi9601/mcp-testkit": "workspace:*",
    "vitest": ">=2.0.0 <5.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@vitest/runner": "^4.1.10",
    "@vitest/utils": "^4.1.10",
    "typescript": "^5.0.0",
    "vitest": "4.1.10"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Youzi9601/mcp-testkit"
  }
}
