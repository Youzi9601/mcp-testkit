{
  "name": "@youzi9601/mcp-testkit",
  "version": "0.1.6",
  "description": "Testing framework for MCP servers",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "testing",
    "test-framework",
    "typescript",
    "json-rpc",
    "vitest"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./test-utils": {
      "types": "./dist/test-utils/index.d.ts",
      "default": "./dist/test-utils/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "test": "vitest run src",
    "test:coverage": "vitest run src --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "peerDependencies": {
    "vitest": ">=2.0.0 <5.0.0"
  },
  "devDependencies": {
    "vitest": "4.1.9"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Youzi9601/mcp-testkit"
  }
}
