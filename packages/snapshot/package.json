{
  "name": "@youzi9601/mcp-testkit-snapshot",
  "version": "0.1.5",
  "description": "Snapshot testing plugin for MCP servers",
  "keywords": [
    "mcp",
    "snapshot",
    "snapshot-testing",
    "vitest",
    "model-context-protocol"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "test": "vitest run src",
    "lint": "eslint src",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "vitest": ">=2.0.0 <4.0.0",
    "@youzi9601/mcp-testkit": "workspace:*"
  },
  "devDependencies": {
    "vitest": "3.2.6",
    "@types/node": "^25.9.3",
    "typescript": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Youzi9601/mcp-testkit"
  }
}
