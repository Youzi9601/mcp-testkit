{
  "name": "@youzi9601/mcp-testkit-vitest",
  "version": "0.1.3",
  "description": "Vitest plugin for mcp-testkit",
  "keywords": [
    "mcp",
    "vitest",
    "vitest-plugin",
    "testing",
    "model-context-protocol"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "peerDependencies": {
    "vitest": ">=2.0.0 <4.0.0",
    "@youzi9601/mcp-testkit": "^0.1.0"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'No linter configured'"
  },
  "dependencies": {
    "@youzi9601/mcp-testkit": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Youzi9601/mcp-testkit"
  }
}