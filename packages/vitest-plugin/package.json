{
  "name": "@youzi9601/mcp-testkit-vitest",
  "version": "0.1.6",
  "description": "Vitest plugin for mcp-testkit",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "keywords": [
    "mcp",
    "vitest",
    "vitest-plugin",
    "testing",
    "model-context-protocol"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "test": "vitest run src",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@youzi9601/mcp-testkit": "workspace:*"
  },
  "peerDependencies": {
    "vitest": ">=2.0.0 <4.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "vitest": "4.1.8"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Youzi9601/mcp-testkit"
  }
}
